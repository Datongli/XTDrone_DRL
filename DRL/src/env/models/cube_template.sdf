<sdf version='1.6'>
  <model name='cube'>
    <static>true</static>
    <link name='link'>
      <collision name='collision'>
        <geometry>
          <box>
            <size>{size_x} {size_y} {size_z}</size>
          </box>
        </geometry>
      </collision>
      <visual name='visual'>
        <geometry>
          <box>
            <size>{size_x} {size_y} {size_z}</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://xtdrone_drl_materials/materials/scripts</uri>
            <uri>model://xtdrone_drl_materials/materials/textures</uri>
            <name>{materialName}</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>